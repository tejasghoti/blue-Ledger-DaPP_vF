{
  "buildCommand": "cd blue-ledger-ai-verifier && npm install && npm run build",
  "outputDirectory": "blue-ledger-ai-verifier/dist",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/blue-ledger-ai-verifier/api/index.js"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
